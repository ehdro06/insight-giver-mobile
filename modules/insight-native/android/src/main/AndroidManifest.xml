<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives insight pushes in native code, without starting React Native. -->
    <service
      android:name=".InsightMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <receiver
      android:name=".InsightWidgetReceiver"
      android:exported="true"
      android:label="@string/insight_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/insight_widget_info" />
    </receiver>
  </application>
</manifest>
